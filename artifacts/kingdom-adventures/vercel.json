{
  "functions": {
    "api/battle-run.py": {
      "includeFiles": "api/{_battle_runtime/**,_battle_preview.py}",
      "maxDuration": 60,
      "memory": 1024
    },
    "api/discord-provider.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/sitemap.xml"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/static-v/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ka-auth/discord-provider",
      "destination": "/api/discord-provider"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://kingdom-adventures-game-data-and-tools.onrender.com/api/$1"
    },
    {
      "source": "/ka-api/(.*)",
      "destination": "https://kingdom-adventures-game-data-and-tools.onrender.com/ka-api/$1"
    },
    {
      "source": "/(.*\\..*)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
