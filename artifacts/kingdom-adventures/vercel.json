{
  "routes": [
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/sitemap.xml"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://kingdom-adventures-game-data-and-tools.onrender.com/api/$1" },
    { "source": "/ka-api/(.*)", "destination": "https://kingdom-adventures-game-data-and-tools.onrender.com/ka-api/$1" },
    { "source": "/(.*\\..*)", "destination": "/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
