{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://kingdom-adventures-game-data-and-tools.onrender.com/api/$1"
    },
    {
      "source": "/ka-api/(.*)",
      "destination": "https://kingdom-adventures-game-data-and-tools.onrender.com/ka-api/$1"
    }
  ]
}
